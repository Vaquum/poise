# Optional Confab proxy. The URL below is the built-in default.
CONFAB_API_KEY=
CONFAB_URL=http://localhost:8000

# Seeds the agent account (Settings → GitHub → Agent account), the GitHub user
# reviews and comments are posted as, on the first start without one saved.
# Settings owns it after that; this value is then ignored.
REVIEW_AGENT_USERNAME=

# Production server. Poise deliberately supports loopback hosts only.
POISE_HOST=127.0.0.1
POISE_PORT=5555

# Optional storage overrides. Blank values use ~/.poise defaults.
# POISE_DB=/absolute/path/to/cache.db
# POISE_DEV_DB=/absolute/path/to/development-cache.db
# POISE_DATASTORE_DB=/absolute/path/to/github-datastore.sqlite
# POISE_GITHUB_USER=your-human-github-login
# POISE_EDITOR_DIR=/absolute/path/to/editor
# POISE_CHAT_ATTACHMENTS_DIR=/absolute/path/to/chat-attachments
# POISE_ESPANSO_MATCH_DIR=/absolute/path/to/espanso/match

# Caller runs from caller/ (npm run caller:setup builds caller/.venv); set
# AGENT_INTERFACE_ROOT and CALLER_BIN_ROOT together only to run another one.
# AGENT_INTERFACE_ROOT=/absolute/path/to/agent_interface
# CALLER_BIN_ROOT=/absolute/path/to/caller/.venv/bin
# AGENT_INTERFACE_DATA_DIR=/absolute/path/to/durable/agent-interface/data

# Optional writer voice guide.
# POISE_VOICE_GUIDE_PATH=/absolute/path/to/voice-guide.md
# Optional voice guide /content writes in; without one it writes without.
# AGENT_INTERFACE_VOICE_GUIDE=/absolute/path/to/voice-guide.md

# Optional JEV typed primitive evaluations. Server-only; never use a VITE_ prefix.
# Keep .env private (chmod 600 .env) and restart Poise after adding the key.
JEV_API_KEY=
