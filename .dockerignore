dist
dist.previous
gateway/dist
**/coverage
playwright-report
test-results
.playwright-mcp
.poise-dev
.poise-chat
.claude
**/.env
**/.env.*
caller/.venv
caller/agent_interface/data
caller/*/build
caller/*/*.egg-info
**/__pycache__
**/.pytest_cache
link/src-tauri/target
link/src-tauri/gen/schemas
**/.DS_Store
