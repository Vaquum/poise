# The workspace integration proof must reach Engine bridge addresses, including
# when the checkout is on macOS and the Engine runs inside Docker Desktop.
FROM docker:29-cli AS engine-client
FROM node:22-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=engine-client /usr/local/bin/docker /usr/local/bin/docker
COPY --from=engine-client /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json vitest.config.ts ./
COPY src ./src
COPY tests ./tests
ENV POISE_GATEWAY_DOCKER_TESTS=1 DOCKER_HOST=unix:///var/run/docker.sock
# Both files discover managed containers on the same Engine; their fixture lifetimes must not overlap.
CMD ["node_modules/.bin/vitest", "run", "--no-file-parallelism", "tests/docker.integration.test.ts", "tests/diagnostics.docker.test.ts"]
