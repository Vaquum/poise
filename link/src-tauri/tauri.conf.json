{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poise Link",
  "identifier": "com.vaquum.poise.link",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Poise Link",
        "width": 440,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Desktop companion for Poise",
    "longDescription": "Poise Link keeps Espanso in sync with your Poise snippets and shows Poise alerts as native notifications, even while the browser is closed.",
    "copyright": "Copyright (c) 2026 Mikko Kotila",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
