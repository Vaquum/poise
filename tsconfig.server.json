{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "tsBuildInfoFile": "node_modules/.cache/poise/tsconfig.server.tsbuildinfo"
  },
  "include": ["server/**/*.ts", "vite.config.ts"]
}
