# Settings of the Poise service, read by deploy/compose.yaml and the scripts
# beside it. Copy this file to deploy/.env, fill it in and keep it private:
#
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#
# Apply a change with deploy/install.sh. docs/Operating.md walks through the
# setup; gateway/README.md lists every setting the gateway reads.

# ---- Required -------------------------------------------------------------

# The apex host name. People sign in at https://<POISE_DOMAIN>/, and each
# person's workspace is https://<their GitHub login>.<POISE_DOMAIN>/. DNS
# needs an A or AAAA record for it and one for *.<POISE_DOMAIN>.
# Example: poise.example.com
POISE_DOMAIN=

# The GitHub OAuth App people sign in with. Its authorization callback URL
# is https://<POISE_DOMAIN>/auth/callback.
# Example: Ov23liA1b2C3d4E5f6G7
POISE_GITHUB_CLIENT_ID=
# Example: 0123456789abcdef0123456789abcdef01234567
POISE_GITHUB_CLIENT_SECRET=

# GitHub logins that administer this Poise at https://<POISE_DOMAIN>/admin.
# Admins may always sign in. Separate several with commas.
# Example: octocat
POISE_ADMINS=

# The address Let's Encrypt writes to about the certificates Caddy obtains.
# Not needed with POISE_PROXY_LISTEN, where your own proxy obtains them.
# Example: ops@example.com
POISE_ACME_EMAIL=

# ---- Behind a proxy the server already runs -------------------------------

# Set this when another reverse proxy on the server, such as a Caddy or nginx
# serving other sites, already holds ports 80 and 443. This installation then
# runs no Caddy of its own and publishes the gateway, over plain http, on this
# one address, for that proxy to send POISE_DOMAIN and *.POISE_DOMAIN to.
# Name an IP address and port only the proxy can reach, never 0.0.0.0 or [::].
# docs/Operating.md, "Behind your own proxy", says what the proxy must do.
# Example: 127.0.0.1:8080
# POISE_PROXY_LISTEN=

# ---- Who else may sign in -------------------------------------------------

# GitHub logins that may sign in. Admins can add and remove more on the admin
# page; a login listed here can only be removed here.
# Example: alice,bob
POISE_ALLOWED_USERS=

# GitHub organisations whose active members may sign in. Membership is
# checked at every sign-in, which then also asks for the read:org scope.
# Example: acme
POISE_ALLOWED_ORGS=

# ---- Workspaces -----------------------------------------------------------

# The workspace image deploy/install.sh and deploy/upgrade.sh build.
# Default: poise-runtime:latest
# POISE_RUNTIME_IMAGE=poise-runtime:latest

# Limits of each person's workspace container: memory, CPUs and processes.
# Agents build code and run test suites in there. Defaults: 8g, 4 and 4096.
# POISE_WORKSPACE_MEMORY=8g
# POISE_WORKSPACE_CPUS=4
# POISE_WORKSPACE_PIDS=4096

# The disk a workspace's home volume may use before Settings -> Admin and the
# gateway's log flag it, as a size such as 50g; 0 flags none. Default: 50g.
# POISE_WORKSPACE_DISK_BUDGET=50g

# Seconds an upgrade waits for a busy workspace to finish what it is doing
# before it recreates the container anyway. Default: 1800 (30 minutes).
# POISE_DRAIN_TIMEOUT=1800

# An OCI runtime for the workspaces. runsc (gVisor) gives each workspace its
# own application kernel; install it and register it with Docker first
# (docs/Operating.md, "Security"). Default: Docker's runc.
# POISE_WORKSPACE_RUNTIME=runsc

# Resolvers the workspaces ask instead of Docker's embedded DNS, as one to
# three IP addresses. Required with runsc: gVisor cannot reach Docker's
# resolver, and without one a workspace resolves no host at all.
# POISE_WORKSPACE_DNS=1.1.1.1,8.8.8.8

# ---- End-to-end tests only; never set these on a real server ---------------
# POISE_INSECURE_HTTP=1 serves plain http, for *.localhost and *.test domains.
# POISE_GITHUB_URL and POISE_GITHUB_API_URL point sign-in at a fake GitHub.
# POISE_WORKSPACE_SKIP_CLI_BOOTSTRAP=1 gives workspaces no provider CLIs.
